# Root .gitignore for OutBoxLab

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example

# Build outputs
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# OS & IDE
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime logs and caches
logs/
*.log
uploads/
tmp/
temp/

# Backend local test scripts (as per assignment instruction)
Backend/tests/
tests/
